{
  "version": 1,
  "description": "polaris: inject the plain-answer skill on every user prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-plain-answer.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
